{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Rootstock",
  "options": {
    "deploymentTarget": {
      "macOS": "26.0"
    },
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "packages": {
    "SwiftTerm": {
      "url": "https://github.com/migueldeicaza/SwiftTerm",
      "from": "1.2.0"
    },
    "Sparkle": {
      "url": "https://github.com/sparkle-project/Sparkle",
      "from": "2.6.4"
    }
  },
  "targets": {
    "Rootstock": {
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Rootstock",
          "CFBundleShortVersionString": "$(MARKETING_VERSION)",
          "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
          "ITSAppUsesNonExemptEncryption": false,
          "LSApplicationCategoryType": "public.app-category.developer-tools",
          "SUFeedURL": "https://github.com/carlosefonseca/Rootstock/releases/latest/download/appcast.xml",
          "SUPublicEDKey": "/gOrIqoYbQ0+PR+lKHoz40PK7shfzj8Y7BsE6csOhZA=",
          "SUEnableAutomaticChecks": true,
          "SUScheduledCheckInterval": 86400
        }
      },
      "platform": "macOS",
      "settings": {
        "base": {
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
          "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
          "CURRENT_PROJECT_VERSION": "1",
          "MARKETING_VERSION": "1.0",
          "PRODUCT_BUNDLE_IDENTIFIER": "com.carlosefonseca.Rootstock",
          "PRODUCT_NAME": "$(TARGET_NAME)",
          "SWIFT_VERSION": "5.0",
          "CODE_SIGN_IDENTITY": "-",
          "CODE_SIGN_STYLE": "Automatic"
        },
        "configs": {
          "Release": {
            "CODE_SIGN_IDENTITY": "Developer ID Application",
            "CODE_SIGN_STYLE": "Manual",
            "DEVELOPMENT_TEAM": "VF8BTMF3F4",
            "ENABLE_HARDENED_RUNTIME": "YES",
            "OTHER_CODE_SIGN_FLAGS": "--timestamp",
            "CODE_SIGN_INJECT_BASE_ENTITLEMENTS": "NO"
          }
        }
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "dependencies": [
        {
          "package": "SwiftTerm",
          "product": "SwiftTerm"
        },
        {
          "package": "Sparkle",
          "product": "Sparkle"
        }
      ],
      "type": "application"
    }
  }
}
